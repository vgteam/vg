{
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
    "features": {
        "ghcr.io/devcontainers/features/node:1": {},
        "ghcr.io/devcontainers/features/python:1": {},
        "ghcr.io/ttyrho/devcontainer-features/gcc:1": {},
        "ghcr.io/devcontainers/features/rust:1": {},
        "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
        "ghcr.io/devcontainers/features/common-utils:2": { "username": "${localEnv:USER}" }
    },
    "mounts": [
        "source=${localEnv:HOME}/.claude,target=/home/${env:USERNAME}/.claude,type=bind",
        "source=/private/groups/patenlab/anovak,target=/private/groups/patenlab/anovak,type=bind",
        "source=/private/groups/migalab/shnegi,target=/private/groups/migalab/shnegi,type=bind"
    ],
    "initializeCommand": "mkdir -p $HOME/.claude",
    "remoteUser": "${localEnv:USER}",
    "containerUser": "${localEnv:USER}",
    "postCreateCommand": "make get-deps"
}

